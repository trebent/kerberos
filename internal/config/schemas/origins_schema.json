{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://trebent.com/kerberos/schemas/origins_schema.json",
  "type": "object",
  "description": "Origin management settings.",
  "properties": {
    "allowedOrigins": {
      "type": "array",
      "description": "List of allowed origins for CORS.",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "allowAll": {
      "type": "boolean",
      "description": "Whether to allow all origins for CORS. Mutually exclusive with 'allowedOrigins'.",
      "default": false
    }
  },
  "oneOf": [
    {
      "required": [
        "allowedOrigins"
      ]
    },
    {
      "required": [
        "allowAll"
      ]
    }
  ],
  "additionalProperties": false
}