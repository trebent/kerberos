{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://trebent.com/kerberos/schemas/admin_schema.json",
  "type": "object",
  "description": "Administration configuration.",
  "properties": {
    "api": {
      "type": "object",
      "description": "Settings for the Administration API.",
      "properties": {
        "cookies": {
          "$ref": "http://trebent.com/kerberos/schemas/cookies_schema.json"
        },
        "origins": {
          "$ref": "http://trebent.com/kerberos/schemas/origins_schema.json"
        },
        "tls": {
          "type": "object",
          "description": "TLS settings for the administration API, this also includes Basic authentication (if enabled).",
          "properties": {
            "serverCertFile": {
              "type": "string",
              "description": "Path to a PEM-encoded server certificate."
            },
            "serverKeyFile": {
              "type": "string",
              "description": "Path to a PEM-encoded server key."
            }
          },
          "required": [
            "serverCertFile",
            "serverKeyFile"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "superUser": {
      "type": "object",
      "description": "Superuser settings. The credentials are only used to create the superuser on the first start.",
      "properties": {
        "clientId": {
          "type": "string",
          "default": "admin"
        },
        "clientSecret": {
          "type": "string",
          "description": "Initial superuser password, 10 to 64 characters.",
          "minLength": 10,
          "maxLength": 64
        }
      },
      "required": [
        "clientSecret"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "superUser"
  ],
  "additionalProperties": false
}