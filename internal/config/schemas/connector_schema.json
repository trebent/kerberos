{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://trebent.com/kerberos/schemas/connector_schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "persistence": {
      "$ref": "http://trebent.com/kerberos/schemas/persistence_schema.json"
    },
    "origins": {
      "$ref": "http://trebent.com/kerberos/schemas/origins_schema.json"
    },
    "tls": {
      "type": "object",
      "description": "Server TLS settings for the connector proxy.",
      "additionalProperties": false,
      "properties": {
        "serverCertFile": {
          "type": "string",
          "description": "Path to a PEM-encoded server certificate."
        },
        "serverKeyFile": {
          "type": "string",
          "description": "Path to a PEM-encoded server key."
        }
      },
      "required": [
        "serverCertFile",
        "serverKeyFile"
      ]
    },
    "targetTls": {
      "type": "object",
      "description": "TLS settings for the proxied service behind the connector.",
      "additionalProperties": false,
      "properties": {
        "rootCAFile": {
          "type": "string",
          "description": "Path to a PEM-encoded CA bundle used to verify the backend's certificate."
        },
        "insecureSkipVerify": {
          "type": "boolean",
          "default": false,
          "description": "Disables server certificate verification."
        }
      },
      "if": {
        "properties": {
          "insecureSkipVerify": {
            "const": false
          }
        },
        "required": [
          "insecureSkipVerify"
        ]
      },
      "then": {
        "required": [
          "rootCAFile"
        ]
      },
      "anyOf": [
        {
          "required": [
            "insecureSkipVerify"
          ]
        },
        {
          "required": [
            "rootCAFile"
          ]
        }
      ]
    }
  },
  "required": [
    "persistence"
  ]
}