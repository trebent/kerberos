{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://trebent.com/kerberos/schemas/router_schema.json",
  "type": "object",
  "description": "Configuration for the Gateway router, which defines how incoming requests are routed to backend services.",
  "properties": {
    "backends": {
      "type": "array",
      "description": "Backends contain all the targets that Kerberos proxies.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the backend.",
            "minLength": 1,
            "maxLength": 100
          },
          "host": {
            "type": "string",
            "description": "Host address of the backend.",
            "minLength": 1,
            "maxLength": 256
          },
          "port": {
            "type": "integer",
            "description": "Port number of the backend.",
            "minimum": 1,
            "maximum": 65535
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "default": 5000,
            "description": "Request timeout in milliseconds for the backend."
          },
          "origins": {
            "$ref": "http://trebent.com/kerberos/schemas/origins_schema.json"
          },
          "tls": {
            "type": "object",
            "properties": {
              "rootCAFile": {
                "type": "string",
                "description": "Path to a PEM-encoded CA bundle used to verify the backend's certificate."
              },
              "clientCertFile": {
                "type": "string",
                "description": "Path to a PEM-encoded client certificate for mTLS."
              },
              "clientKeyFile": {
                "type": "string",
                "description": "Path to a PEM-encoded client key for mTLS."
              },
              "insecureSkipVerify": {
                "type": "boolean",
                "default": false,
                "description": "Disables server certificate verification."
              }
            },
            "required": [
              "rootCAFile"
            ],
            "if": {
              "anyOf": [
                {
                  "required": [
                    "clientCertFile"
                  ]
                },
                {
                  "required": [
                    "clientKeyFile"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "clientCertFile",
                "clientKeyFile"
              ]
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "host",
          "port"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "backends"
  ],
  "additionalProperties": false
}