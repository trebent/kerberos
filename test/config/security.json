{
  "admin": {
    "api": {
      "cookies": {
        "domain": "krbtest.com",
        "sameSite": "Lax"
      },
      "origins": {
        "allowedOrigins": [
          "http://www.safe.com"
        ]
      },
      "tls": {
        "serverCertFile": "/certs/krb_server.pem",
        "serverKeyFile": "/certs/krb_server.key"
      }
    }
  },
  "observability": {
    "enabled": false
  },
  "gateway": {
    "tls": {
      "serverCertFile": "/certs/krb_server.pem",
      "serverKeyFile": "/certs/krb_server.key"
    },
    "router": {
      "backends": [
        {
          "name": "mtls-echo",
          "host": "mtls-echo",
          "port": 15000,
          "tls": {
            "rootCAFile": "/certs/ca.crt",
            "clientCertFile": "/certs/krb_client.pem",
            "clientKeyFile": "/certs/krb_client.key",
            "insecureSkipVerify": false
          }
        },
        {
          "name": "tls-echo",
          "host": "tls-echo",
          "port": 15000,
          "tls": {
            "rootCAFile": "/certs/ca.crt",
            "insecureSkipVerify": false
          }
        }
      ]
    }
  },
  "oas": {
    "mappings": [
      {
        "backend": "${ref:gateway.router.backends[0].name}",
        "specification": "/oas/echo.yaml"
      }
    ],
    "order": 100
  }
}